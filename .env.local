# .env.local — dùng cho docker-compose.local.yml
# Thay các giá trị có dấu <...> trước khi chạy

# ── Neo4j ──────────────────────────────────────────────────────────
NEO4J_USER=neo4j
NEO4J_PASS=123456789
NEO4J_URI=bolt://social-neo4j:7687

# ── JWT ────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_KEY=3cfa76ef14937c1c0ea519f8fc057a80fcd04a7420f8e8bcd0a7567c272e007b
JWT_ACCESS_TOKEN_DURATION=3600000
JWT_REFRESH_TOKEN_DURATION=86400000
VERIFY_EMAIL_DURATION=900000

# ── Mail (Gmail App Password) ──────────────────────────────────────
MAIL_USERNAME=<your-gmail>@gmail.com
MAIL_PASSWORD=<gmail-app-password>
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

# ── CORS Origins (local) ───────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000
SELF_ORIGIN=http://localhost:2003

# ── Redis ──────────────────────────────────────────────────────────
REDIS_HOST=social-redis
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_PORT=6379

# ── MinIO ──────────────────────────────────────────────────────────
MINIO_ENDPOINT=http://social-minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=social-app
MINIO_PUBLIC_URL=http://localhost:9000

# ── Google OAuth2 ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=<google-client-id>

# ── Stringee (có thể để trống nếu không dùng call) ─────────────────
STRINGEE_API_SID=<stringee-api-sid>
STRINGEE_API_SECRET_KEY=<stringee-api-secret>

# ── Gemini AI ──────────────────────────────────────────────────────
GEMINI_KEY=<gemini-api-key>