# ============================================================
# LOCAL DEVELOPMENT — .env.local
# This file is NOT committed to git (already in .gitignore).
#
# For Vercel deployment, set these same keys in the Vercel
# dashboard under Project → Settings → Environment Variables.
# ============================================================

# Base URL of the Spring Boot backend.
# FIX: This must be defined or axios.js uses undefined as baseURL,
#      causing every API call to hit the Vercel domain instead of
#      the backend, and token-refresh loops forever.
NEXT_PUBLIC_API_URL=http://localhost:2003

# WebSocket (STOMP over SockJS) endpoint.
# FIX: Without this, socket.js reads process.env.NEXT_PUBLIC_SOCKET_ENDPOINT
#      as undefined. SockJS then builds its /info probe URL relative to the
#      current page origin (Vercel), which is why you see:
#        GET https://social-app-dev-truong.vercel.app/home/info 404
#      Setting it to the backend /ws endpoint fixes all STOMP connections.
NEXT_PUBLIC_SOCKET_ENDPOINT=http://localhost:2003/ws
NEXT_PUBLIC_GOOGLE_CLIENT_ID=176404193195-akfsg9vfdcb9kjtm616asfmjkdmp7ija.apps.googleusercontent.com