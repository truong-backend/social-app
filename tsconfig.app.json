{
  "compilerOptions": {
    /* Core */
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    /* Paths (alias) */
    "paths": {
      "@/*": ["./src/*"],
      "@features/*": ["./src/features/*"],
      "@components/*": ["./src/components/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@services/*": ["./src/services/*"],
      "@stores/*": ["./src/stores/*"],
      "@types/*": ["./src/types/*"],
      "@utils/*": ["./src/utils/*"],
      "@config/*": ["./src/config/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@pages/*": ["./src/pages/*"],
      "@providers/*": ["./src/providers/*"],
      "@routes/*": ["./src/routes/*"]
    },

    /* Strict + build */
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,

    /* Optional (an toàn) */
    "resolveJsonModule": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,

    /* Vite */
    "types": ["vite/client"]
  },
  "include": ["src"]
}